<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PlantCare" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/inverse_primary</item>
        <item name="colorOnPrimary">@color/on_primary_container</item>
        <item name="colorPrimaryContainer">@color/primary</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/sage_green</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/inverse_surface</item>
        <item name="colorSurface">@color/inverse_surface</item>
        <item name="colorOnSurface">@color/inverse_on_surface</item>

        <item name="android:statusBarColor">@color/inverse_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/inverse_surface</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PlantCare.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PlantCare.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PlantCare.LargeComponent</item>
    </style>

    <style name="Theme.PlantCare.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
